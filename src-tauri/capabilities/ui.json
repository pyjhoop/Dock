{
  "identifier": "ui",
  "windows": ["main"],
  "webviews": ["main"],
  "permissions": [
    "core:default", "core:window:allow-set-focus", "core:window:allow-show", "core:window:allow-hide",
    "core:window:allow-minimize", "core:window:allow-toggle-maximize", "core:window:allow-close",
    "core:window:allow-start-dragging", "core:window:allow-is-maximized",
    "dialog:default", "opener:default", "notification:default",
    "allow-get-state", "allow-add-account", "allow-update-account", "allow-remove-account",
    "allow-reorder-accounts", "allow-set-settings", "allow-show-view", "allow-set-rect",
    "allow-set-overlay", "allow-reload-view", "allow-view-nav", 
    "allow-set-passcode", "allow-clear-passcode", "allow-unlock", "allow-lock-app",
    "allow-list-downloads", "allow-download-action", "allow-clear-downloads",
    "allow-quit-app", "allow-finish-login", "allow-open-external", "allow-test-notification", "allow-check-update", "allow-install-update-cmd"
  ]
}
